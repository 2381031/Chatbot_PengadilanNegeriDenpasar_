{
  "version": 2,
  "builds": [
    {
      "src": "backend/serverless.ts",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "Logo.png",
      "use": "@vercel/static"
    },
    {
      "src": "PandePintar.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/serverless.ts"
    },
    {
      "src": "/Logo.png",
      "dest": "/Logo.png"
    },
    {
      "src": "/PandePintar.png",
      "dest": "/PandePintar.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}